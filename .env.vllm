# vLLM Configuration for RLVR/GRPO Training

# CRITICAL: Disable torch.compile to avoid vLLM 0.11.2 bug with PyTorch 2.9.0
# This prevents "UnboundLocalError: tracer_output" crash on server startup
VLLM_TORCH_COMPILE_LEVEL=0

# Attention backend - FlashInfer for optimal performance
VLLM_ATTENTION_BACKEND=FLASHINFER

# Logging
VLLM_LOGGING_LEVEL=INFO

# Performance optimizations
TORCH_CUDNN_V8_API_ENABLED=1
CUDA_MODULE_LOADING=LAZY
